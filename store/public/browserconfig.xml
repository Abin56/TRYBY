<?xml version="1.0" encoding="utf-8"?>
<browserconfig>
  <msapplication>
    <tile>
      <square70x70logo src="/brand/tryby-icon-64.png"/>
      <square150x150logo src="/brand/tryby-icon-128.png"/>
      <square310x310logo src="/brand/tryby-icon-256.png"/>
